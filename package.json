{
  "name": "magic-life-counter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/generate-sw.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:pwa": "node --test tests/pwa.test.mjs"
  },
  "dependencies": {
    "next": "16.1.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "lucide-react": "^1.14.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "tailwindcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.7",
    "tsx": "^4.20.0"
  }
